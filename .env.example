# Copy to .env.local when developing integrations. Keep these server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
OPENAI_API_KEY=

# Optional local-only bearer token for the sandbox plan endpoint (32+ characters).
PLANMIRROR_SANDBOX_READ_TOKEN=

# Optional override for structured offer extraction.
OPENAI_MODEL=gpt-4.1-mini
