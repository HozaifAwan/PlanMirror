# Ayaan (DevOps): Coordinate server-side credential setup with Sujeeth (OpenAI).
# Copy to .env.local when developing integrations. Keep these server-side.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Generate a random secret of at least 32 characters. Never expose in frontend code.
PLANMIRROR_SANDBOX_READ_TOKEN=
# Optional: existing test plan for local verification.
PAYPAL_SANDBOX_PLAN_ID=
OPENAI_API_KEY=
# Optional server-side model override for the floating page guide.
PLANMIRROR_CHAT_MODEL=gpt-5.6-luna

# AG Studio browser SDK license; supplied at runtime, never hardcode or log.
AG_STUDIO_LICENSE_KEY=
